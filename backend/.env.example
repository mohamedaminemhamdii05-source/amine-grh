# Amine GRH - backend environment variables
# Copy this file to ".env" (same folder) and replace every placeholder with your own values.
# Never commit or share the real .env file.

# ---------- required ----------

# Secret used to sign login tokens. Use a long random value (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-secret

# Default admin account - created automatically on first start if no admin exists in the database.
# EMAIL and PASS are the credentials you log in with. To change them later, run: node update-admin.js
EMAIL=admin@example.com
PASS=change-me
TEL=00000000

# ---------- optional (defaults shown) ----------

# MongoDB connection string (local MongoDB, or MongoDB Atlas: mongodb+srv://user:password@cluster/grh75)
MONGO_URI=mongodb://127.0.0.1:27017/grh75

# Port the server listens on (most hosting services set PORT automatically)
PORT=3000

# How long a login stays valid (examples: 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Website addresses allowed to call the API, comma separated.
# Only needed when the frontend is hosted on a different address than the backend.
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Set to 1 when running behind a hosting proxy (Render, Railway, Heroku, Nginx...)
# so the login attempt limiter sees the real visitor IP.
# TRUST_PROXY=1

# PUBLIC DEMO ONLY. When "true", the server ERASES the database on every start and loads
# fictional demo data, and the login page shows one-click demo logins.
# Never set this on a database with real data.
# DEMO_MODE=true
